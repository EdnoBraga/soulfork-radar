# No servidor estas variáveis vão no painel do Easypanel (aba Environment),
# não em arquivo. Localmente, copie para .env.

# Obrigatórias em produção (o wsgi.py não sobe sem elas; mínimo 12 caracteres)
FIND_SENHA=
FIND_SECRET_KEY=

# Chave da Google Places API (New): console.cloud.google.com -> projeto ->
# "Places API (New)" ativada -> Credenciais -> Chave de API. Restrinja a chave
# à Places API (New); NÃO use restrição por referer (a chamada sai do servidor).
GOOGLE_PLACES_API_KEY=

# Business Discovery da Meta (opcional; também dá para salvar pela tela Configuração)
META_IG_TOKEN=
META_IG_USER_ID=

# Pasta gravável (banco, exportações). No contêiner já vem como /data (volume).
# FIND_DADOS=/data
